<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!--
	  这里填的是「项目希望用的组」，**但运行时并不以它为准**。

	  正式签名（付费账号 / TestFlight）时它生效。
	  自签时签名工具会把这一项换成它自己那套（如 group.163448086d837d1e.N），
	  所以运行时改为按「本进程实际生效的 entitlements」自动解析 —— 见
	  CheckJuiceStore/AppGroup.swift。**别再指望这里填什么就能得到什么。**

	  两个文件（本文件 + CheckJuiceWidget.entitlements）保持一致即可。
	-->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.com.llkhs.CheckJuice</string>
	</array>
</dict>
</plist>
